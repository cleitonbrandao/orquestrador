# Credenciais e artefatos locais — nunca versionar
*accounts*.json
*credentials*.json
*secrets*
*.local.json
*.key
*.pem
.env
.env.*

# Backups gerados pelo instalador
*.bak
*.bak.*
opencode.json.backup*

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# cache de telemetria local
graft/

# Python
__pycache__/
*.pyc

# Testes de modelos: só o CSV consolidado é versionado
docs/resultados/*/
docs/resultados/relatorio.html
