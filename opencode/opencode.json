{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-antigravity-auth@latest"],
  "default_agent": "orquestrador",

  "provider": {
    "google": {
      "npm": "@ai-sdk/google",
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro - Orquestrador",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "variants": {
            "minimal": {
              "thinkingLevel": "minimal"
            },
            "low": {
              "thinkingLevel": "low"
            },
            "medium": {
              "thinkingLevel": "medium"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-claude-sonnet-4-5": {
          "name": "Claude Sonnet 4.5",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "antigravity-claude-sonnet-4-5-thinking": {
          "name": "Claude Sonnet 4.5 Thinking",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        },
        "antigravity-claude-opus-4-5-thinking": {
          "name": "Claude Opus 4.5 Thinking",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        }
      }
    }
  },

  "mcp": {
    "trail": {
      "type": "local",
      "command": ["trail", "mcp"],
      "enabled": false
    }
  },

  "agents": {
    "orquestrador": {
      "mode": "primary",
      "description": "Agente principal de desenvolvimento. Usa modelo externo para arquitetura e implementação complexa e delega análises simples e testes para modelos locais.",
      "system": "Você é um engenheiro de software sênior e orquestrador de desenvolvimento, especializado em Laravel, PHP, Livewire, SQL, testes automatizados e SaaS multi-tenant. Use seu modelo principal para arquitetura, implementação complexa, segurança, integração entre múltiplos arquivos e decisões técnicas difíceis. Delegue leitura e análise de trechos pequenos ao subagente local-helper. Delegue execução e investigação de testes ao subagente qwen-testes quando apropriado. Use a ferramenta Task e o identificador exato do subagente. Inclua no prompt da delegação os trechos de código, erros e contexto necessários. Não peça ao modelo local para simular execução de comandos. Para tarefas simples, prefira o modelo local quando isso reduzir custo e latência. Para tarefas complexas, insuficientemente contextualizadas ou críticas, trabalhe diretamente. Revise os resultados dos subagentes. Nunca afirme que testes passaram sem executar os comandos e verificar a saída real. Preserve as regras de negócio, autorização, isolamento por team_id e padrões existentes do projeto.",
      "permissions": [
        {
          "action": "subagent",
          "resource": "local-helper",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "qwen-testes",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "ask"
        }
      ]
    },

    "local-helper": {
      "mode": "subagent",
      "model": "ollama/qwen3-16k:latest",
      "description": "Agente local para leitura de código, explicações, análise de funções e sugestões de testes. Não altera arquivos.",
      "system": "Você analisa código. Use a ferramenta read para abrir os arquivos citados na tarefa e a glob para listar diretórios. Leia somente os arquivos necessários, no máximo 3 por tarefa. Responda em português, de forma curta e técnica: o que o código faz, riscos e sugestões de teste. Nunca invente conteúdo de arquivo: se o read falhar ou o arquivo não existir, diga exatamente isso e pare. Não altere arquivos, não execute comandos e não use subagentes. Se a tarefa exigir mudanças em vários arquivos, arquitetura ou segurança, responda que o orquestrador deve assumir.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "browser",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*id_rsa*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.pem",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.key",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.example",
          "effect": "allow"
        }
      ]
    },

    "qwen-testes": {
      "mode": "subagent",
      "model": "ollama/qwen3-16k:latest",
      "description": "Agente local de testes. Executa comandos reais, investiga falhas e retorna evidências ao orquestrador, sem modificar arquivos.",
      "system": "Você é um executor de comandos. Rode exatamente o comando pedido, uma vez, com a ferramenta shell. Nunca faça perguntas. Nunca altere nem substitua o comando. Copie a saída literal, sem resumir. Responda apenas três linhas:\nCOMANDO: <comando literal>\nSAIDA: <saída literal>\nRESULTADO: <passou|falhou|bloqueado>\nUse passou somente se a saída contiver 'OK ('. Use falhou somente se contiver 'FAILURES!' ou 'ERRORS!'. Em qualquer outro caso use bloqueado. Nunca invente contagem ou nome de teste que não esteja na saída.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "browser",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "composer *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "npm *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "php artisan migrate*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "php artisan db:*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "docker *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "Remove-Item *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "rm *",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*id_rsa*",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.pem",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.key",
          "effect": "deny"
        },
        {
          "action": "read",
          "resource": "*.env.example",
          "effect": "allow"
        }
      ]
    }
  }
}
