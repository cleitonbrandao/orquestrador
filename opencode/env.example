# Variáveis opcionais do opencode — copie para o seu ~/.zshrc (ou ~/.bashrc) e ajuste.
# Sem estas variáveis, os defaults do opencode.json de cada projeto valem.

# Modelo do subagente local-helper (análises simples delegadas pelo orquestrador).
# Aponte para qualquer modelo declarado no provider Ollama do projeto
# ou para um modelo de nuvem (ex.: google/gemini-2.5-flash) em máquinas sem GPU.
#export LOCAL_HELPER_MODEL=ollama/qwen2.5-coder:7b

# Modelo do agente primário qwen-testes (executor de testes Laravel local).
#export QWEN_TESTES_MODEL=ollama/qwen2.5-coder:7b
